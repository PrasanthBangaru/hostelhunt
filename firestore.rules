rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for hostels and subcollections so students can explore before login
    match /hostels/{hostelId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Allow read/write for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}